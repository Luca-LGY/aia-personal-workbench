{
  "name": "aia-personal-workbench",
  "version": "0.1.0",
  "description": "Local personal work and life archive",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:electron": "playwright test",
    "test:visual": "playwright test tests/electron/visual.spec.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run package:mac && npm run test:electron",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "postinstall": "electron-builder install-app-deps",
    "test:package": "playwright test tests/electron/packaged-app.spec.ts"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "chokidar": "6.0.0",
    "diff3": "0.0.4",
    "fast-xml-parser": "5.11.2",
    "ignore": "5.3.2",
    "lucide-react": "1.61.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
